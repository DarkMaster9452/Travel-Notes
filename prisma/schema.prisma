// SIDEQUEST — schema
// Postgres (Neon). Connection URLs live in `prisma.config.ts` (Prisma 7);
// the app connects through the node-postgres driver adapter in src/lib/db.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

/// Who someone is, as opposed to what they have paid for.
///
/// Guests are not represented here — a guest has no account, sees only the
/// landing page, and never reaches a real quest. Admins are flagged in the
/// database and never self-serve: nothing in the product writes this column.
enum Role {
  USER
  ADMIN
}

/// Which palette the signed-in app renders in. `SYSTEM` follows the device;
/// the other two are a deliberate choice and outrank it.
enum Theme {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  name           String
  avatar         String?
  passwordHash   String  @map("password_hash")
  role           Role    @default(USER)
  freeQuestsUsed Int     @default(0) @map("free_quests_used")
  /// Stored on the account rather than in localStorage so the server can render
  /// the right palette on the first paint — a theme that arrives after
  /// hydration is a flash of the wrong one.
  theme          Theme   @default(SYSTEM)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  preferences  UserPreferences?
  submissions  Submission[]      @relation("SubmissionAuthor")
  reviewed     Submission[]      @relation("SubmissionReviewer")
  subscription Subscription?
  sessions     Session[]
  generations  QuestGeneration[]
  history      QuestHistory[]
  savedQuests  SavedQuest[]
  scheduled    QuestSchedule[]   @relation("ScheduleAuthor")
  revocations  AchievementRevocation[] @relation("RevocationSubject")
  revoked      AchievementRevocation[] @relation("RevocationAuthor")
  awards       LeaderboardAward[]      @relation("AwardHolder")

  @@map("users")
}

/// Server-side session records. The cookie holds a signed JWT whose `sid`
/// claim points here, so sessions can be revoked server-side on logout.
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum Plan {
  FREE
  EXPLORER
  ULTRA
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  status               SubscriptionStatus @default(INCOMPLETE)
  plan                 Plan               @default(FREE)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Preferences (captured during onboarding)
// ---------------------------------------------------------------------------

enum DifficultyPreference {
  EASY
  MODERATE
  HARD
  SURPRISE
}

enum TimeAvailable {
  SHORT // 1–2 h
  HALF // 2–4 h
  LONG // 4–6 h
  FULL // full day
  SURPRISE
}

enum Transport {
  CAR
  PUBLIC_TRANSPORT
  BIKE
  WALKING
}

enum QuestStyle {
  RELAXED
  ADVENTUROUS
  CHALLENGING
  RANDOM
}

enum Ternary {
  YES
  NO
  SURPRISE
}

model UserPreferences {
  id                   String               @id @default(cuid())
  userId               String               @unique @map("user_id")
  homeLocation         String               @map("home_location")
  homeLatitude         Float?               @map("home_latitude")
  homeLongitude        Float?               @map("home_longitude")
  /// Max travel radius from home, in km.
  maxDistance          Int                  @default(50) @map("max_distance")
  /// Preferred route length, in km.
  preferredDistance    Int                  @default(10) @map("preferred_distance")
  difficulty           DifficultyPreference @default(SURPRISE)
  /// Tags: forest, mountains, water, rocks, history, views, hidden, long_hikes
  preferredTerrain     String[]             @default([]) @map("preferred_terrain")
  /// Tags: photography, exploration, challenge, nature, solo, couple, friends
  preferredActivity    String[]             @default([]) @map("preferred_activity")
  /// Tags: waterfalls, lakes, rivers, caves, castles, ruins, ridges, meadows
  preferredEnvironment String[]             @default([]) @map("preferred_environment")
  timeAvailable        TimeAvailable        @default(SURPRISE) @map("time_available")
  transport            Transport            @default(CAR)
  questStyle           QuestStyle           @default(ADVENTUROUS) @map("quest_style")
  sunsetPreference     Ternary              @default(SURPRISE) @map("sunset_preference")
  waterPreference      Ternary              @default(SURPRISE) @map("water_preference")
  elevationPreference  Ternary              @default(SURPRISE) @map("elevation_preference")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ---------------------------------------------------------------------------
// Quests
// ---------------------------------------------------------------------------

enum Difficulty {
  EASY
  MODERATE
  HARD
  EXPERT
}

model Quest {
  id            String     @id @default(cuid())
  /// Sequential per-user quest number (QUEST #17). Null for showcase quests.
  number        Int?
  title         String
  subtitle      String
  description   String
  objective     String
  bonus         String?
  safetyNotes   String?    @map("safety_notes")
  location      String
  region        String
  country       String     @default("Slovakia")
  latitude      Float
  longitude     Float
  /// Route length in km.
  distance      Float
  /// Estimated moving time in minutes.
  duration      Int
  /// Estimated travel time from the user's home, in minutes.
  travelTime    Int?       @map("travel_time")
  difficulty    Difficulty
  elevationGain Int        @map("elevation_gain")
  terrain       String[]   @default([])
  features      String[]   @default([])
  mood          String?
  coverImage    String     @map("cover_image")
  routeData     Json?      @map("route_data")
  /// Stable hash of the defining parameter combination. Powers anti-repetition.
  signature     String
  /// Showcase quests are seeded examples used on the landing page.
  isShowcase    Boolean    @default(false) @map("is_showcase")
  /// Only published quests can be issued. Admins write this; nothing else does.
  published     Boolean    @default(true)
  /// Free-text grouping shown in the panel — Hiking, Nature, Coastal, …
  category      String?
  createdAt     DateTime   @default(now()) @map("created_at")

  generations QuestGeneration[]
  history     QuestHistory[]
  saved       SavedQuest[]
  submissions Submission[]
  schedules   QuestSchedule[]

  @@index([isShowcase])
  @@index([published])
  @@index([signature])
  @@map("quests")
}

/// The two cadences the product runs on. The monthly is the headline quest;
/// the weekly is the smaller one alongside it.
enum SchedulePeriod {
  WEEKLY
  MONTHLY
}

/// A quest booked into a specific week or month.
///
/// One quest per slot, enforced by the database rather than by the form: two
/// quests claiming the same Monday is not a state the product has an answer
/// for, so it is made unrepresentable. Editing which quest fills a slot is
/// allowed; adding a second to an occupied slot is not.
///
/// `openAt` is derived on write from the slot itself — Monday 06:00 for a
/// weekly, the 1st at 06:00 for a monthly — and stored so the query that asks
/// "what is live?" is a plain timestamp comparison rather than date arithmetic
/// repeated at every call site.
model QuestSchedule {
  id      String         @id @default(cuid())
  period  SchedulePeriod
  /// `2026-W34` for a weekly, `2026-09` for a monthly. Unique with `period`.
  slotKey String         @map("slot_key")
  questId String         @map("quest_id")

  /// Lowest plan this slot is visible to. `FREE` means everyone.
  audience Plan @default(FREE)

  /// When the slot opens. Monday 06:00 weekly, the 1st 06:00 monthly.
  openAt DateTime @map("open_at")
  /// When the log closes — the instant the next slot opens.
  closeAt DateTime @map("close_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quest     Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ScheduleAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([period, slotKey])
  @@index([openAt])
  @@map("quest_schedules")
}

/// Immutable audit log: every generation event, with the parameters used.
model QuestGeneration {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  questId              String   @map("quest_id")
  generationNumber     Int      @map("generation_number")
  generatedAt          DateTime @default(now()) @map("generated_at")
  generationParameters Json     @map("generation_parameters")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, generationNumber])
  @@index([userId, generatedAt])
  @@map("quest_generations")
}

/// What a user has received. Read by the anti-repetition engine.
model QuestHistory {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  questId     String    @map("quest_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  saved       Boolean   @default(false)
  generatedAt DateTime  @default(now()) @map("generated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId, generatedAt])
  @@map("quest_history")
}

/// Where a submission sits in review. Approve or decline, nothing in between —
/// the panel is a two-way decision and a third state would be a queue that
/// never empties.
enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Proof that somebody actually did the quest.
///
/// Nothing counts until it is checked: logging a quest files one of these, and
/// an admin approves or declines it. The evidence is whatever the person could
/// bring — a written account, photographs, a Strava link, and the figures their
/// watch recorded — and the admin sees all of it side by side against what the
/// quest asked for.
model Submission {
  id      String @id @default(cuid())
  userId  String @map("user_id")
  questId String @map("quest_id")

  /// What happened, in their words. Always required — a submission with no
  /// account of the day is not evidence of anything.
  note      String
  /// Uploaded photograph URLs, in the order they were added.
  photos    String[] @default([])
  stravaUrl String?  @map("strava_url")

  /// What the watch recorded, for the diff against what the quest asked for.
  distance   Float?
  elevation  Int?
  movingTime Int?      @map("moving_time")
  startedAt  DateTime? @map("started_at")

  /// Turned back on purpose. An honest retreat is approved, not failed.
  retreated Boolean @default(false)

  /// Which cadence this was filed against, when it was filed against one.
  ///
  /// Stamped at filing time rather than looked up at review time, because the
  /// slot moves on: a weekly filed on Sunday evening is a weekly, and asking
  /// on Tuesday "is this quest the current weekly?" would answer no. It is
  /// what puts a submission at the front of the review queue, and what the
  /// leaderboard counts as a featured finish, so it has to describe the
  /// moment it was filed and then stop changing.
  period  SchedulePeriod?
  /// The slot it was filed against — `2026-W34` or `2026-09`.
  slotKey String?         @map("slot_key")

  status       SubmissionStatus @default(PENDING)
  reviewedById String?          @map("reviewed_by_id")
  reviewNote   String?          @map("review_note")
  reviewedAt   DateTime?        @map("reviewed_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User  @relation("SubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  quest      Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, questId])
  @@index([status, createdAt])
  @@index([period, slotKey])
  @@map("submissions")
}

/// A sticker taken back from an account.
///
/// Achievements are *derived* — a pure function of quest history — so there is
/// no row to delete when an admin needs to remove one. This is that row: an
/// explicit revocation, checked when the sheet is computed. Storing the
/// exception rather than the whole sheet keeps the achievement definitions the
/// single source of truth and means a threshold can still be changed without a
/// backfill.
///
/// Deliberately not reversible by earning it again: the point of taking a
/// sticker back is usually that the history behind it was wrong, and a badge
/// that silently returned on the next quest would undo the correction. An
/// admin lifts it by deleting the revocation.
model AchievementRevocation {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  /// Matches `Achievement["id"]` in `lib/achievements`.
  achievementId String   @map("achievement_id")
  reason        String?
  revokedById   String?  @map("revoked_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user      User  @relation("RevocationSubject", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("RevocationAuthor", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, achievementId])
  @@map("achievement_revocations")
}

model SavedQuest {
  id      String   @id @default(cuid())
  userId  String   @map("user_id")
  questId String   @map("quest_id")
  savedAt DateTime @default(now()) @map("saved_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId, savedAt])
  @@map("saved_quests")
}

/// Fixed-window rate limiting for expensive endpoints. Persisted so limits
/// survive restarts and hold across serverless instances.
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now()) @map("window_start")

  @@index([windowStart])
  @@map("rate_limits")
}

/// Where a top-three finish landed.
enum Medal {
  GOLD
  SILVER
  BRONZE
}

/// A podium finish on a closed weekly or monthly leaderboard.
///
/// Written once, when the period closes, and never recomputed. The board
/// itself is derived — sum the approved submissions filed inside the window —
/// but a *finish* cannot be, because the inputs keep moving: a submission
/// approved three weeks late, or a verdict reversed, would silently reshuffle
/// a podium somebody has already been given a sticker for. So the moment a
/// slot closes the top three are sealed here, score and all, and the sticker
/// on the account reads from this row rather than from the arithmetic.
///
/// Sealing is idempotent: `@@unique([period, slotKey, rank])` means a second
/// attempt at the same board writes nothing rather than handing out a fourth
/// bronze.
model LeaderboardAward {
  id      String         @id @default(cuid())
  userId  String         @map("user_id")
  period  SchedulePeriod
  /// `2026-W34` for a weekly, `2026-09` for a monthly.
  slotKey String         @map("slot_key")
  /// 1, 2 or 3. Nothing below the podium is stored.
  rank    Int
  medal   Medal
  /// The score as it stood when the slot closed.
  score   Int
  /// How many approved submissions made up that score.
  quests  Int            @default(0)

  awardedAt DateTime @default(now()) @map("awarded_at")

  user User @relation("AwardHolder", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([period, slotKey, rank])
  @@unique([period, slotKey, userId])
  @@index([userId])
  @@map("leaderboard_awards")
}
