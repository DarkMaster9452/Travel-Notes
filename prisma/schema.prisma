// SIDEQUEST — schema
// Postgres (Neon). Connection URLs live in `prisma.config.ts` (Prisma 7);
// the app connects through the node-postgres driver adapter in src/lib/db.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

/// Who someone is, as opposed to what they have paid for.
///
/// Guests are not represented here — a guest has no account, sees only the
/// landing page, and never reaches a real quest. Admins are flagged in the
/// database and never self-serve: nothing in the product writes this column.
/// Five roles, and the gaps between them are the point.
///
/// `USER` is a member. The four above it are the desk, and they are additive:
/// a reader opens the deck and decides proof and sees nothing about money; a
/// writer adds quests and slots; an admin adds users, billing and the database
/// browser; an owner adds the desk itself — invitations, revocations, panel
/// access.
///
/// `OWNER` is deliberately not something the panel can grant. An owner can
/// invite and revoke, but promoting an account *to owner* happens at a
/// database prompt (`scripts/grant-role.ts`), because a panel that can mint
/// owners is one compromised session away from making an attacker permanent.
enum Role {
  USER
  READER
  WRITER
  ADMIN
  OWNER
}

/// Which palette the signed-in app renders in. `SYSTEM` follows the device;
/// the other two are a deliberate choice and outrank it.
enum Theme {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  avatar           String?
  passwordHash     String   @map("password_hash")
  role             Role     @default(USER)
  freeQuestsUsed   Int      @default(0) @map("free_quests_used")
  /// Stored on the account rather than in localStorage so the server can render
  /// the right palette on the first paint — a theme that arrives after
  /// hydration is a flash of the wrong one.
  theme            Theme    @default(SYSTEM)
  /// Achievement ids this account has already been shown as earned. Stickers
  /// are derived, so there is no row whose creation could mark the moment —
  /// this is what makes "new since you last looked" answerable, and it is why
  /// the sheet can celebrate an unlock exactly once.
  seenAchievements String[] @default([]) @map("seen_achievements")
  /// When this admin last opened the back-office room. Null means never, and
  /// everything counts as unread. A column rather than a table because it is
  /// one timestamp per account and a join table for that would be a table
  /// with exactly as many rows as there are admins.
  adminChatReadAt  DateTime? @map("admin_chat_read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  preferences  UserPreferences?
  logDefaults  UserLogDefaults?
  profile      Profile?
  submissions  Submission[]            @relation("SubmissionAuthor")
  reviewed     Submission[]            @relation("SubmissionReviewer")
  subscription Subscription?
  sessions     Session[]
  generations  QuestGeneration[]
  history      QuestHistory[]
  savedQuests  SavedQuest[]
  scheduled    QuestSchedule[]         @relation("ScheduleAuthor")
  revocations  AchievementRevocation[] @relation("RevocationSubject")
  revoked      AchievementRevocation[] @relation("RevocationAuthor")
  awards       LeaderboardAward[]      @relation("AwardHolder")
  adminMessages AdminMessage[]         @relation("AdminChatAuthor")
  strava        StravaAccount?
  groups        GroupMembership[]      @relation("GroupMember")
  groupsCreated Group[]                @relation("GroupAuthor")
  display       DisplaySettings?
  shipping      ShippingAddress?
  notifications NotificationSettings?
  nudges        Nudge[]
  despatched    StickerDespatch[]
  activity      ActivityDay[]
  auditEntries  AdminAudit[]           @relation("AuditActor")
  invitesSent   StaffInvite[]          @relation("InviteAuthor")

  @@map("users")
}

/// Server-side session records. The cookie holds a signed JWT whose `sid`
/// claim points here, so sessions can be revoked server-side on logout.
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

/// Four of Stripe's subscription statuses, plus two of our own.
///
/// `INCOMPLETE` is not a Stripe status. It marks the gap between "we have a
/// customer record for this account" and "a subscription exists", and it is
/// also where an unrecognised Stripe status lands — denying access is the
/// safe direction to be wrong in. `PAUSED` is not a Stripe status either:
/// Stripe expresses a pause as a subscription's own `pause_collection` field
/// staying set while `status` itself keeps reading `active` (see
/// `mapStripeStatus` in `src/lib/stripe.ts`), and this is where that state is
/// written down on our side.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  PAUSED
  CANCELED
  INCOMPLETE
}

enum Plan {
  FREE
  EXPLORER
  ULTRA
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  status               SubscriptionStatus @default(INCOMPLETE)
  plan                 Plan               @default(FREE)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")

  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Preferences (captured during onboarding)
// ---------------------------------------------------------------------------

enum DifficultyPreference {
  EASY
  MODERATE
  HARD
  SURPRISE
}

enum TimeAvailable {
  SHORT // 1–2 h
  HALF // 2–4 h
  LONG // 4–6 h
  FULL // full day
  SURPRISE
}

enum Transport {
  CAR
  PUBLIC_TRANSPORT
  BIKE
  WALKING
}

enum QuestStyle {
  RELAXED
  ADVENTUROUS
  CHALLENGING
  RANDOM
}

enum Ternary {
  YES
  NO
  SURPRISE
}

model UserPreferences {
  id                   String               @id @default(cuid())
  userId               String               @unique @map("user_id")
  homeLocation         String               @map("home_location")
  homeLatitude         Float?               @map("home_latitude")
  homeLongitude        Float?               @map("home_longitude")
  /// Max travel radius from home, in km.
  maxDistance          Int                  @default(50) @map("max_distance")
  /// Preferred route length, in km.
  preferredDistance    Int                  @default(10) @map("preferred_distance")
  difficulty           DifficultyPreference @default(SURPRISE)
  /// Tags: forest, mountains, water, rocks, history, views, hidden, long_hikes
  preferredTerrain     String[]             @default([]) @map("preferred_terrain")
  /// Tags: photography, exploration, challenge, nature, solo, couple, friends
  preferredActivity    String[]             @default([]) @map("preferred_activity")
  /// Tags: waterfalls, lakes, rivers, caves, castles, ruins, ridges, meadows
  preferredEnvironment String[]             @default([]) @map("preferred_environment")
  timeAvailable        TimeAvailable        @default(SURPRISE) @map("time_available")
  transport            Transport            @default(CAR)
  questStyle           QuestStyle           @default(ADVENTUROUS) @map("quest_style")
  sunsetPreference     Ternary              @default(SURPRISE) @map("sunset_preference")
  waterPreference      Ternary              @default(SURPRISE) @map("water_preference")
  elevationPreference  Ternary              @default(SURPRISE) @map("elevation_preference")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ---------------------------------------------------------------------------
// Quests
// ---------------------------------------------------------------------------

enum Difficulty {
  EASY
  MODERATE
  HARD
  EXPERT
}

model Quest {
  id            String     @id @default(cuid())
  /// Sequential per-user quest number (QUEST #17). Null for showcase quests.
  number        Int?
  title         String
  subtitle      String
  description   String
  objective     String
  bonus         String?
  safetyNotes   String?    @map("safety_notes")
  location      String
  region        String
  country       String     @default("Slovakia")
  latitude      Float
  longitude     Float
  /// Route length in km.
  distance      Float
  /// Estimated moving time in minutes.
  duration      Int
  /// Estimated travel time from the user's home, in minutes.
  travelTime    Int?       @map("travel_time")
  difficulty    Difficulty
  elevationGain Int        @map("elevation_gain")
  terrain       String[]   @default([])
  features      String[]   @default([])
  mood          String?
  coverImage    String     @map("cover_image")
  routeData     Json?      @map("route_data")
  /// Stable hash of the defining parameter combination. Powers anti-repetition.
  signature     String
  /// Showcase quests are seeded examples used on the landing page.
  isShowcase    Boolean    @default(false) @map("is_showcase")
  /// Only published quests can be issued. Admins write this; nothing else does.
  published     Boolean    @default(true)
  /// Free-text grouping shown in the panel — Hiking, Nature, Coastal, …
  category      String?

  /// Where to leave the car. Optional throughout: plenty of starts are a bus
  /// stop or a village square, and an empty parking panel is better than an
  /// invented one. The coordinates are of a public car park, never of a
  /// person — the "no exact coordinates" promise is about home addresses.
  parkingName  String? @map("parking_name")
  parkingLat   Float?  @map("parking_lat")
  parkingLng   Float?  @map("parking_lng")
  /// "Free, fills by 08:00 at weekends. Barrier closes at dusk."
  parkingNote  String? @map("parking_note")
  /// Minutes from the car park to the actual start of the route.
  approachTime Int?    @map("approach_time")
  /// How to get there without a car, when there is a way.
  transitNote  String? @map("transit_note")

  createdAt DateTime @default(now()) @map("created_at")

  generations QuestGeneration[]
  history     QuestHistory[]
  saved       SavedQuest[]
  submissions Submission[]
  schedules   QuestSchedule[]

  @@index([isShowcase])
  @@index([published])
  @@index([signature])
  @@map("quests")
}

/// The two cadences the product runs on. The monthly is the headline quest;
/// the weekly is the smaller one alongside it.
enum SchedulePeriod {
  WEEKLY
  MONTHLY
}

/// A quest booked into a specific week or month.
///
/// One quest per slot, enforced by the database rather than by the form: two
/// quests claiming the same Monday is not a state the product has an answer
/// for, so it is made unrepresentable. Editing which quest fills a slot is
/// allowed; adding a second to an occupied slot is not.
///
/// `openAt` is derived on write from the slot itself — Monday 06:00 for a
/// weekly, the 1st at 06:00 for a monthly — and stored so the query that asks
/// "what is live?" is a plain timestamp comparison rather than date arithmetic
/// repeated at every call site.
model QuestSchedule {
  id      String         @id @default(cuid())
  period  SchedulePeriod
  /// `2026-W34` for a weekly, `2026-09` for a monthly. Unique with `period`.
  slotKey String         @map("slot_key")
  questId String         @map("quest_id")

  /// Lowest plan this slot is visible to. `FREE` means everyone.
  audience Plan @default(FREE)

  /// When the slot opens. Monday 06:00 weekly, the 1st 06:00 monthly.
  openAt  DateTime @map("open_at")
  /// When the log closes — the instant the next slot opens.
  closeAt DateTime @map("close_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quest     Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ScheduleAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([period, slotKey])
  @@index([openAt])
  @@map("quest_schedules")
}

/// Immutable audit log: every generation event, with the parameters used.
model QuestGeneration {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  questId              String   @map("quest_id")
  generationNumber     Int      @map("generation_number")
  generatedAt          DateTime @default(now()) @map("generated_at")
  generationParameters Json     @map("generation_parameters")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, generationNumber])
  @@index([userId, generatedAt])
  @@map("quest_generations")
}

/// What a user has received. Read by the anti-repetition engine.
model QuestHistory {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  questId     String    @map("quest_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  saved       Boolean   @default(false)
  generatedAt DateTime  @default(now()) @map("generated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId, generatedAt])
  @@map("quest_history")
}

/// Where a submission sits in review. Approve or decline, nothing in between —
/// the panel is a two-way decision and a third state would be a queue that
/// never empties.
enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Proof that somebody actually did the quest.
///
/// Nothing counts until it is checked: logging a quest files one of these, and
/// an admin approves or declines it. The evidence is whatever the person could
/// bring — a written account, photographs, a Strava link, and the figures their
/// watch recorded — and the admin sees all of it side by side against what the
/// quest asked for.
model Submission {
  id      String @id @default(cuid())
  userId  String @map("user_id")
  questId String @map("quest_id")

  /// What happened, in their words. Always required — a submission with no
  /// account of the day is not evidence of anything.
  note      String
  /// Uploaded photograph URLs, in the order they were added.
  photos    String[] @default([])
  stravaUrl String?  @map("strava_url")

  /// What the watch recorded, for the diff against what the quest asked for.
  distance   Float?
  elevation  Int?
  movingTime Int?      @map("moving_time")
  startedAt  DateTime? @map("started_at")

  /// Turned back on purpose. An honest retreat is approved, not failed.
  retreated Boolean @default(false)

  /// Which cadence this was filed against, when it was filed against one.
  ///
  /// Stamped at filing time rather than looked up at review time, because the
  /// slot moves on: a weekly filed on Sunday evening is a weekly, and asking
  /// on Tuesday "is this quest the current weekly?" would answer no. It is
  /// what puts a submission at the front of the review queue, and what the
  /// leaderboard counts as a featured finish, so it has to describe the
  /// moment it was filed and then stop changing.
  period  SchedulePeriod?
  /// The slot it was filed against — `2026-W34` or `2026-09`.
  slotKey String?         @map("slot_key")

  status       SubmissionStatus @default(PENDING)
  reviewedById String?          @map("reviewed_by_id")
  reviewNote   String?          @map("review_note")
  reviewedAt   DateTime?        @map("reviewed_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User  @relation("SubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  quest      Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, questId])
  @@index([status, createdAt])
  @@index([period, slotKey])
  @@map("submissions")
}

/// What somebody would otherwise retype into every submission.
///
/// Saved from the proof form, and only when the checkbox is ticked — filing a
/// log should never quietly change your account. Prefilled into the next form,
/// where it is ordinary editable text: this is a starting point, not a claim.
///
/// Deliberately *not* the figures. Distance, ascent and moving time are
/// measurements of one particular day, and prefilling them would put last
/// week's numbers in front of somebody a click away from filing them as this
/// week's. They are remembered — the form shows them as a note beside the
/// empty field, so you have something to sanity-check against — but they are
/// never filled in for you.
model UserLogDefaults {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  /// Their Strava profile, so an activity link is a paste rather than a hunt.
  stravaProfile String? @map("strava_profile")
  /// "07:00" — the hour they usually set out.
  usualStart    String? @map("usual_start")
  /// Who is normally with them. 1 is alone.
  partySize     Int?    @map("party_size")
  /// "Trail shoes, poles, 2 l water." Short, theirs to word.
  gear          String?
  /// Roughly how fast, in minutes per kilometre on the flat.
  pace          Float?

  /// The last figures they filed. Shown beside the fields, never in them.
  lastDistance   Float? @map("last_distance")
  lastElevation  Int?   @map("last_elevation")
  lastMovingTime Int?   @map("last_moving_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_log_defaults")
}

/// The ink a profile is printed in. A short list on purpose: somebody should
/// be recognisable by their colour, which stops working at twenty of them.
enum ProfileAccent {
  PINE
  MOSS
  STONE
  WATER
  CLAY
  DUSK
  SIGNAL
}

/// A page about a person, for the people they might walk with.
///
/// Off by default and off until they say otherwise. `published` is the whole
/// privacy model: an unpublished profile is visible to its owner and to nobody
/// else, and un-publishing takes it away again immediately rather than
/// scheduling a deletion. Even published, it is only visible to signed-in
/// accounts — this is a members' product and a page meant for the person you
/// are about to meet at a trailhead has no business being indexed.
///
/// Every field on it is optional and every section can be switched off. What
/// somebody chooses not to fill in is simply absent from the page, never shown
/// as a blank or a prompt to the reader: an empty profile should read as
/// private rather than as unfinished.
///
/// Deliberately not on `User`. The account is the thing that signs in and gets
/// billed; this is a thing they publish, and the two have different lifetimes,
/// different privacy rules and different people looking at them.
model Profile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  /// The bit after `/people/`. Theirs to choose, unique across the product.
  handle    String  @unique
  published Boolean @default(false)

  /// What to call them here, if not the name on the account.
  displayName String? @map("display_name")
  /// One line, under the name. "Weekend ridges and cold water."
  headline    String?
  bio         String?

  /// Handles, not URLs — the URL is built when it is rendered, so nothing
  /// somebody pastes can turn into a link to somewhere else entirely.
  instagram String?
  facebook  String?
  strava    String?

  accent ProfileAccent @default(PINE)

  /// What the page shows. Each one is a real switch, not a hint.
  showStats      Boolean @default(true) @map("show_stats")
  showCountry    Boolean @default(true) @map("show_country")
  showActivities Boolean @default(true) @map("show_activities")
  showStickers   Boolean @default(true) @map("show_stickers")
  /// The year grid. Its own switch rather than riding on `showActivities`,
  /// because it describes time spent here rather than ground covered — a
  /// different thing to be public about, and some people will want one
  /// without the other.
  showActivityGrid Boolean @default(true) @map("show_activity_grid")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([published])
  @@map("profiles")
}

/// A sticker taken back from an account.
///
/// Achievements are *derived* — a pure function of quest history — so there is
/// no row to delete when an admin needs to remove one. This is that row: an
/// explicit revocation, checked when the sheet is computed. Storing the
/// exception rather than the whole sheet keeps the achievement definitions the
/// single source of truth and means a threshold can still be changed without a
/// backfill.
///
/// Deliberately not reversible by earning it again: the point of taking a
/// sticker back is usually that the history behind it was wrong, and a badge
/// that silently returned on the next quest would undo the correction. An
/// admin lifts it by deleting the revocation.
model AchievementRevocation {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  /// Matches `Achievement["id"]` in `lib/achievements`.
  achievementId String   @map("achievement_id")
  reason        String?
  revokedById   String?  @map("revoked_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user      User  @relation("RevocationSubject", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("RevocationAuthor", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, achievementId])
  @@map("achievement_revocations")
}

model SavedQuest {
  id      String   @id @default(cuid())
  userId  String   @map("user_id")
  questId String   @map("quest_id")
  savedAt DateTime @default(now()) @map("saved_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId, savedAt])
  @@map("saved_quests")
}

/// Fixed-window rate limiting for expensive endpoints. Persisted so limits
/// survive restarts and hold across serverless instances.
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now()) @map("window_start")

  @@index([windowStart])
  @@map("rate_limits")
}

/// Where a top-three finish landed.
enum Medal {
  GOLD
  SILVER
  BRONZE
}

/// A podium finish on a closed weekly or monthly leaderboard.
///
/// Written once, when the period closes, and never recomputed. The board
/// itself is derived — sum the approved submissions filed inside the window —
/// but a *finish* cannot be, because the inputs keep moving: a submission
/// approved three weeks late, or a verdict reversed, would silently reshuffle
/// a podium somebody has already been given a sticker for. So the moment a
/// slot closes the top three are sealed here, score and all, and the sticker
/// on the account reads from this row rather than from the arithmetic.
///
/// Sealing is idempotent: `@@unique([period, slotKey, rank])` means a second
/// attempt at the same board writes nothing rather than handing out a fourth
/// bronze.
model LeaderboardAward {
  id      String         @id @default(cuid())
  userId  String         @map("user_id")
  period  SchedulePeriod
  /// `2026-W34` for a weekly, `2026-09` for a monthly.
  slotKey String         @map("slot_key")
  /// 1, 2 or 3. Nothing below the podium is stored.
  rank    Int
  medal   Medal
  /// The score as it stood when the slot closed.
  score   Int
  /// How many approved submissions made up that score.
  quests  Int            @default(0)

  awardedAt DateTime @default(now()) @map("awarded_at")

  user User @relation("AwardHolder", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([period, slotKey, rank])
  @@unique([period, slotKey, userId])
  @@index([userId])
  @@map("leaderboard_awards")
}

/// A message in the back office.
///
/// One room, no channels, no threads. There are a handful of admins and one
/// subject — what is happening to this product today — so a chat with
/// somewhere to put things is a chat where things get put somewhere nobody
/// looks. Everything is in one stream, in order, and the whole of it is
/// visible to anybody who can open the panel.
///
/// Not a customer feature and deliberately not reachable from the customer
/// side: `requireAdmin` guards the page and every action that touches this
/// table.
///
/// The author is nullable and detaches rather than cascading. Deleting a
/// colleague's account should not silently rewrite last month's decisions out
/// of the record — the message stays, attributed to nobody, the same way a
/// reviewed submission keeps its verdict when the reviewer is gone.
model AdminMessage {
  id       String  @id @default(cuid())
  authorId String? @map("author_id")
  body     String

  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")

  author User? @relation("AdminChatAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_messages")
}

// ---------------------------------------------------------------------------
// Connected apps
// ---------------------------------------------------------------------------

/// A member's Strava connection.
///
/// Its own table rather than columns on `User` for the reason every OAuth
/// connection eventually needs: it has a lifetime of its own. Disconnecting is
/// deleting a row, which is a thing that can be done exactly and completely,
/// rather than nulling five columns and hoping none was missed.
///
/// The access token is short-lived by Strava's design — six hours — so the
/// refresh token is the thing that matters here, and `expiresAt` is stored so
/// a refresh happens before a call fails rather than after.
model StravaAccount {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  /// Strava's own id for the athlete. Stable, and what their API paths use.
  athleteId    String    @map("athlete_id")
  accessToken  String    @map("access_token")
  refreshToken String    @map("refresh_token")
  /// When the access token dies. Refreshed a minute early, never on failure.
  expiresAt    DateTime  @map("expires_at")
  scope        String    @default("")
  /// What to call them in the settings row — Strava's own display name.
  athleteName  String?   @map("athlete_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("strava_accounts")
}

// ---------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------

enum GroupRole {
  OWNER
  MEMBER
}

/// A handful of people who walk together, and a board of their own.
///
/// Deliberately thin: a name, a line about it, and who is in it. There is no
/// group-owned content, no group quests and no group settings beyond that,
/// because everything a group would want to *do* already exists per-person —
/// what a group adds is a smaller board to read, and a page to find each other
/// on.
///
/// Membership is only ever visible to members. A group whose roster could be
/// read from outside would leak exactly what the profile privacy model spends
/// its whole design refusing to leak: who has an account.
model Group {
  id     String @id @default(cuid())
  /// The bit after `/people/groups/`. Chosen once, unique across the product.
  slug   String @unique
  name   String
  blurb  String?

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User?             @relation("GroupAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  members   GroupMembership[]

  @@map("groups")
}

model GroupMembership {
  id      String    @id @default(cuid())
  groupId String    @map("group_id")
  userId  String    @map("user_id")
  role    GroupRole @default(MEMBER)

  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_memberships")
}

// ---------------------------------------------------------------------------
// Account settings
// ---------------------------------------------------------------------------

enum Units {
  METRIC
  IMPERIAL
}

/// How figures and dates are written for one account.
///
/// Its own table rather than more columns on `UserPreferences`, because that
/// model is about *what quest to generate* and this is about how the product
/// is read. Mixing them means every quest generation reads four columns it has
/// no use for.
model DisplaySettings {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  units    Units  @default(METRIC)
  /// BCP-47, and only the ones the product actually ships copy for.
  language String @default("en")
  /// Show the extra per-quest figures. Explorer and Ultra only; the entitlement
  /// is what decides whether it can be turned on, this only records the wish.
  expertStats Boolean @default(false) @map("expert_stats")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("display_settings")
}

/// Where the envelope goes.
///
/// Quest cards and stickers are posted, so this is a real address rather than
/// a billing formality. Nullable everywhere except the country, because a
/// half-filled address is a state somebody is legitimately in halfway through
/// typing one, and refusing to store it would lose what they had typed.
model ShippingAddress {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  recipient String?
  line1     String?
  line2     String?
  city      String?
  postcode  String?
  country   String  @default("Slovakia")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shipping_addresses")
}

/// Something the product needs to ask for, later.
///
/// The whole reason this table exists is the word *later*. An ask that lands
/// in the middle of something good — "you have unlocked Explorer, now type
/// your postcode" — turns the good thing into a form, and people answer it
/// worse than if it had waited a day. So the ask is queued with a time on it
/// and shown when that time comes, once, as a notice they can answer or wave
/// away.
///
/// One row per kind per account, so activating twice does not queue the same
/// question twice. `doneAt` and `dismissedAt` are deliberately separate: the
/// first means we got what we asked for, the second means we did not, and the
/// consequences of those two differ (an account with no address gets an email
/// instead of an envelope).
model Nudge {
  id     String    @id @default(cuid())
  userId String    @map("user_id")
  kind   NudgeKind

  /// Not shown before this instant.
  dueAt DateTime @map("due_at")

  seenAt      DateTime? @map("seen_at")
  doneAt      DateTime? @map("done_at")
  dismissedAt DateTime? @map("dismissed_at")

  /// What the ask is about — the plan that was activated, for instance.
  context Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId, dueAt])
  @@map("nudges")
}

/// Which printed stickers have actually gone in an envelope.
///
/// Stickers are derived, so there is no row whose existence means "earned" —
/// and that was fine until something had to be posted. Without a log the
/// despatch job cannot tell a sticker it has already sent from one it has not,
/// and the promise of "two in each envelope" has no way of being kept: the job
/// would either send the same two every month or send none, which is what it
/// did.
///
/// One row per account per sticker, written the moment it is put in a
/// despatch list. Unique on the pair, so a job that runs twice on the 2nd
/// posts nothing twice.
model StickerDespatch {
  id     String @id @default(cuid())
  userId String @map("user_id")

  /// The achievement id, matching `lib/achievements`. Ids there are frozen
  /// precisely so this column keeps meaning something.
  achievementId String @map("achievement_id")

  postedAt DateTime @default(now()) @map("posted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, postedAt])
  @@map("sticker_despatches")
}

/// One row per account per day something happened.
///
/// The public profile draws a year of these as a grid, so this is the record
/// behind "how much somebody is around". Deliberately a *count per day* rather
/// than a row per event: the grid only ever asks how busy a day was, a year of
/// days is 365 rows instead of thousands, and nothing here can be worked
/// backwards into a timeline of exactly what somebody did and when.
///
/// Written by `lib/activity`, which is fire-and-forget — a failed write must
/// never roll back the thing the person actually did.
model ActivityDay {
  id     String @id @default(cuid())
  userId String @map("user_id")

  /// The UTC calendar day, at midnight. UTC throughout, matching the rest of
  /// the reporting, so two profiles side by side are comparable.
  day DateTime @db.Date

  count Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
  @@map("activity_days")
}

enum NudgeKind {
  /// Where the monthly envelope should go. Asked a day after a plan that
  /// includes post is activated, never at the moment of activating it.
  SHIPPING_ADDRESS
}

/// Which emails an account has asked for.
///
/// Every one defaults on except product news: the four that are on are the
/// product telling somebody something happened to *their* quest or their
/// verdict, which is the thing they subscribed for. Marketing is the one that
/// has to be asked for.
model NotificationSettings {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  /// Monday 06:00 and the 1st.
  questDrop   Boolean @default(true) @map("quest_drop")
  /// Approved or sent back.
  verdict     Boolean @default(true)
  /// A monthly board closing with your name on it.
  boardSealed Boolean @default(true) @map("board_sealed")
  /// Anything that is not one of the above.
  productNews Boolean @default(false) @map("product_news")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}


/// Every write made from the panel.
///
/// Reads are not logged, deliberately: a log of who looked at what would be a
/// second surveillance product nobody asked for, and it would bury the writes
/// that actually matter. What is here is what somebody *changed*, who they
/// were, and what it was about.
///
/// The actor detaches rather than cascades. Deleting a colleague's account
/// should not rewrite last month's decisions out of the record — the entry
/// stays, attributed to nobody, exactly as a reviewed submission keeps its
/// verdict when the reviewer is gone.
model AdminAudit {
  id      String  @id @default(cuid())
  actorId String? @map("actor_id")
  /// A short verb-phrase key: `submission.approved`, `quest.published`, …
  action  String
  /// What it was about, in one line a human can read without a join.
  subject String
  /// Anything worth keeping beyond the subject. Never a secret.
  detail  String?

  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@map("admin_audit")
}


/// An invitation to the desk.
///
/// The panel can invite and it can revoke; it cannot promote. An invite names
/// an email and a role, and it is claimed by *that* email signing in and
/// opening the link — so an invite that leaks is still useless to anybody who
/// cannot receive mail at the address it was written to.
///
/// One live invite per email, enforced by the unique index: re-inviting
/// somebody replaces the invitation rather than leaving two tokens alive.
model StaffInvite {
  id    String @id @default(cuid())
  email String @unique
  /// Never `OWNER`, and never `USER`. Checked in the action, not just here.
  role  Role   @default(READER)

  /// The secret in the link. Random, single-use, and rotated by a resend.
  token String @unique

  invitedById String?  @map("invited_by_id")
  expiresAt   DateTime @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invitedBy User? @relation("InviteAuthor", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("staff_invites")
}


/// One line in the panel's systems log.
///
/// Two different things write here and they are deliberately the same shape:
/// a *probe*, written when somebody loads the systems board and the app checks
/// whether Postgres, Stripe, Resend or Blob answers; and a *run*, written by a
/// scheduled route when it finishes. Both answer the same question — did this
/// part of the product work, how long did it take, and what did it say — so a
/// system's page can show one timeline instead of two.
///
/// Nothing here is a secret and nothing here is personal. `detail` is a line
/// written for a human at the desk: counts, durations, the error's *message*.
/// Never a key, never a token, never an email address.
///
/// Rows are cheap and this table is append-only, so it is swept rather than
/// updated — `pruneSystemEvents` drops anything past the retention window, on
/// the same schedule that writes to it.
model SystemEvent {
  id String @id @default(cuid())

  /// Which system, matching an id in `lib/admin/systems`. A string rather than
  /// an enum because the list of systems changes with the deployment's wiring,
  /// and a migration to add a probe is a migration nobody would write.
  system String

  /// `ok`, `degraded`, `down` or `off`. The same four words the board paints.
  status String

  /// Round trip in milliseconds, where there was one to measure.
  latencyMs Int? @map("latency_ms")

  /// One line a human can read without a join.
  detail String?

  /// True when a scheduled route wrote this, false when a probe did. The
  /// distinction matters on the log: a job that has not run is a real fault, a
  /// probe that has not run just means nobody opened the page.
  ran Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([system, createdAt])
  @@index([createdAt])
  @@map("system_events")
}
