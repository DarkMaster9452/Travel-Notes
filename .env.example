# Summit Quest — environment
#
# Copy to `.env` and fill in. Nothing here has a value committed: every line is
# a name and a note. `src/lib/env.ts` is the authority on which of these are
# required — it validates lazily, on first read, so a build without runtime
# secrets still succeeds and a misconfiguration fails loudly on the first
# request that needs the value rather than silently.

# `NODE_ENV` is deliberately absent. Next.js sets it from the command you run,
# and setting it by hand is how a production build ends up in development mode.

# --- Database -----------------------------------------------------------------

# Neon pooled connection.
DATABASE_URL=
# The same host without `-pooler`. Migrations run over it: Neon's pooler
# multiplexes connections, which the schema engine's advisory locks don't
# tolerate.
DIRECT_URL=

# --- Sessions -----------------------------------------------------------------

# At least 32 characters. Generate with `openssl rand -hex 32`.
AUTH_SECRET=

# Absolute links in email and the billing portal's return. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Billing (Stripe) ----------------------------------------------------------
#
# Three credentials, and all three are needed to sell. The secret key reads
# subscriptions back and creates checkout sessions, the publishable key is what
# Stripe.js is loaded with in the browser to mount the embedded checkout, and
# the webhook secret is what makes an incoming event trustworthy. With any of
# them missing the paywall degrades gracefully rather than erroring — the plan
# cards simply say billing is not configured here.
#
# From the Stripe Dashboard → Developers → API keys. Test keys start
# `sk_test_`/`pk_test_`; live keys start `sk_live_`/`pk_live_`. Nothing in the
# app infers which one a deployment should use — it is simply whichever key
# you paste here, the same way Stripe's own dashboard tells them apart.

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# From the Stripe Dashboard → Product catalogue. Create an "Explorer" product
# with monthly and yearly recurring Prices, and (optionally) an "Ultra
# Explorer" product the same way — without an Ultra price, Ultra is simply not
# offered. Price ids begin `price_`.
STRIPE_PRICE_ID_EXPLORER_MONTHLY=
STRIPE_PRICE_ID_EXPLORER_YEARLY=
STRIPE_PRICE_ID_ULTRA_MONTHLY=
STRIPE_PRICE_ID_ULTRA_YEARLY=

# --- Uploads ------------------------------------------------------------------

# Vercel Blob, for proof photographs. Without it the upload route says so
# instead of failing silently.
BLOB_READ_WRITE_TOKEN=

# --- Email --------------------------------------------------------------------

# Transactional email. Without it messages are logged rather than sent, which is
# a normal state for development and preview branches.
RESEND_API_KEY=
# The From line. Defaults to `Summit Quest <quests@summitquest.app>`.
EMAIL_FROM=

# --- Connected apps -----------------------------------------------------------

# Strava. Without them the connected-apps row reads "not configured".
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Scheduled jobs -----------------------------------------------------------

# Bearer token the scheduled routes require. EMPTY REFUSES EVERY CALL — a job
# anybody on the internet can trigger is worse than one that never runs. The
# systems board reports each job as "never run" until one fires.
CRON_SECRET=
