# Summit Quest — environment
#
# Copy to `.env` and fill in. Nothing here has a value committed: every line is
# a name and a note. `src/lib/env.ts` is the authority on which of these are
# required — it validates lazily, on first read, so a build without runtime
# secrets still succeeds and a misconfiguration fails loudly on the first
# request that needs the value rather than silently.

# `NODE_ENV` is deliberately absent. Next.js sets it from the command you run,
# and setting it by hand is how a production build ends up in development mode.

# --- Database -----------------------------------------------------------------

# Neon pooled connection.
DATABASE_URL=
# The same host without `-pooler`. Migrations run over it: Neon's pooler
# multiplexes connections, which the schema engine's advisory locks don't
# tolerate.
DIRECT_URL=

# --- Sessions -----------------------------------------------------------------

# At least 32 characters. Generate with `openssl rand -hex 32`.
AUTH_SECRET=

# Absolute links in email and the billing portal's return. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Billing (Paddle) ---------------------------------------------------------
#
# Three credentials, and all three are needed to sell. The API key reads
# subscriptions back, the client token is what Paddle.js is initialised with in
# the browser, and the webhook secret is what makes an incoming event
# trustworthy. With any of them missing the paywall degrades gracefully rather
# than erroring, and `DEMO_PLANS` takes over.
#
# Sandbox keys contain `_sdbx`; sandbox client tokens are prefixed `test_`.
# Nothing in the app infers the environment from that — set it explicitly below.

PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

# `sandbox` or `production`. Set BOTH, to the same value: the server picks its
# API host from the first and Paddle.js picks its checkout host from the second,
# so a mismatch means the overlay talks to one environment while the webhook
# writes from the other. Defaults to sandbox — the expensive mistake here is
# billing a real card from a branch, not failing to bill a fake one.
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Price ids from Paddle's catalogue. These begin `pri_` — the `pro_` ids are
# products and the app does not use them. Without the Explorer monthly id
# nothing can be sold; without the Ultra monthly id, Ultra is not offered.
PADDLE_PRICE_ID_EXPLORER_MONTHLY=
PADDLE_PRICE_ID_EXPLORER_YEARLY=
PADDLE_PRICE_ID_ULTRA_MONTHLY=
PADDLE_PRICE_ID_ULTRA_YEARLY=

# Hand every plan over for nothing, activated with a button instead of a
# checkout. Defaults **on** wherever Paddle is not configured, which is the
# honest reading of that state: a deployment that cannot take money and also
# will not hand anything over is a deployment where nothing works. `0` turns it
# off anyway, `1` keeps it on alongside a live Paddle. A demo activation writes
# the same subscription row as a paid one and is marked `demo`, so entitlement
# behaves identically and revenue does not count it.
DEMO_PLANS=

# --- Uploads ------------------------------------------------------------------

# Vercel Blob, for proof photographs. Without it the upload route says so
# instead of failing silently.
BLOB_READ_WRITE_TOKEN=

# --- Email --------------------------------------------------------------------

# Transactional email. Without it messages are logged rather than sent, which is
# a normal state for development and preview branches.
RESEND_API_KEY=
# The From line. Defaults to `Summit Quest <quests@summitquest.app>`.
EMAIL_FROM=

# --- Connected apps -----------------------------------------------------------

# Strava. Without them the connected-apps row reads "not configured".
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Scheduled jobs -----------------------------------------------------------

# Bearer token the scheduled routes require. EMPTY REFUSES EVERY CALL — a job
# anybody on the internet can trigger is worse than one that never runs. The
# systems board reports each job as "never run" until one fires.
CRON_SECRET=
